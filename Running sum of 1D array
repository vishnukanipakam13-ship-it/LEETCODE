class Solution {
    public int[] runningSum(int[] nums) {
       int arr2[] = new int[nums.length];
        arr2[0] = nums[0];

        for(int i = 0;i<nums.length;i++){
            if(i==0){
                arr2[i]=nums[i];
            }else{
                arr2[i]=arr2[i-1]+nums[i];
            }
        }
        return arr2;
    }
}
